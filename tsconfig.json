{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node", "vite-plus/client"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "ui/**/*.ts",
    "ui/**/*.vue",
    "tools/**/*.ts",
    "web/ui/__tests__/**/*.ts",
    "vite.config.ts"
  ]
}
